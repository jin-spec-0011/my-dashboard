{
  "rules": {
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "parking_logs": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$id": {
        ".validate": "newData.hasChild('id')",
        "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "photoBase64": { ".validate": "newData.isString() && newData.val().length <= 500000" },
        "photo": { ".validate": "newData.isString() && newData.val().length <= 500000" }
      }
    },
    "family_todos": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": { ".validate": "newData.hasChild('id')" }
    },
    "family_stickies": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": {
        ".validate": "newData.hasChild('id')",
        "text": { ".validate": "newData.isString() && newData.val().length <= 5000" }
      }
    },
    "family_ledger": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": { ".validate": "newData.hasChild('id')" }
    },
    "family_schedules": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": { ".validate": "newData.hasChild('id')" }
    },
    "family_trips": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": { ".validate": "newData.hasChild('id')" }
    },
    "private_schedules": {
      "$user": {
        ".read": "auth != null && root.child('members').child(auth.uid).val() === $user",
        ".write": "auth != null && root.child('members').child(auth.uid).val() === $user",
        "$i": { ".validate": "newData.hasChild('id')" }
      }
    },
    "calendar_data": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      "$key": {
        ".write": "auth != null && root.child('members').child(auth.uid).exists() && $key.matches(/^calendar_(goal|memo)_[0-9]{4}-[0-9]{2}$/)",
        ".validate": "newData.isString() && newData.val().length <= 5000"
      }
    }
  }
}

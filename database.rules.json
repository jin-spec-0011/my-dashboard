{
  "rules": {
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "parking_logs": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$id": {
        ".validate": "newData.hasChild('id')",
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "photoBase64": {
          ".validate": "newData.isString() && newData.val().length <= 500000"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length <= 500000"
        }
      }
    },
    "family_todos": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": {
        ".validate": "newData.hasChild('id')"
      }
    },
    "family_stickies": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": {
        ".validate": "newData.hasChild('id')",
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        }
      }
    },
    "family_ledger": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": {
        ".validate": "newData.hasChild('id')"
      }
    },
    "family_schedules": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": {
        ".validate": "newData.hasChild('id')"
      }
    },
    "family_trips": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('members').child(auth.uid).exists()",
      "$i": {
        ".validate": "newData.hasChild('id')"
      }
    },
    "private_schedules": {
      "$user": {
        ".read": "auth != null && ($user === 'jinse' || $user === 'jihye') && root.child('members').child(auth.uid).val() === $user",
        ".write": "auth != null && ($user === 'jinse' || $user === 'jihye') && root.child('members').child(auth.uid).val() === $user",
        "$i": {
          ".validate": "newData.hasChild('id')"
        }
      }
    },
    "calendar_data": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      "$key": {
        ".write": "auth != null && root.child('members').child(auth.uid).exists() && $key.matches(/^calendar_(goal|memo)_[0-9]{4}-[0-9]{2}$/)",
        ".validate": "newData.isString() && newData.val().length <= 5000"
      }
    },
    "trip_pending": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      "$car": {
        ".write": "auth != null && root.child('members').child(auth.uid).exists() && ($car === 'x1' || $car === 'accent')",
        ".validate": "newData.child('startId').isNumber() && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('lat').val() >= -90 && newData.child('lat').val() <= 90 && newData.child('lng').val() >= -180 && newData.child('lng').val() <= 180"
      }
    },
    "trip_logs": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && root.child('members').child(auth.uid).exists()",
        ".validate": "$id.matches(/^[0-9]{14}$/) && newData.hasChildren(['id', 'car', 'distance_km']) && (newData.child('car').val() === 'X1' || newData.child('car').val() === '엑센트')",
        "distance_km": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "manual_km": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "flag": {
          ".validate": "newData.val() === 'ok' || newData.val() === 'roundtrip_suspect'"
        }
      }
    },
    "odometer_logs": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && root.child('members').child(auth.uid).exists()",
        ".validate": "$id.matches(/^[0-9]{14}$/) && newData.hasChildren(['id', 'car', 'odometer_km']) && (newData.child('car').val() === 'X1' || newData.child('car').val() === '엑센트')",
        "odometer_km": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
        }
      }
    },
    "maintenance_rules": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      "$car": {
        ".write": "auth != null && root.child('members').child(auth.uid).exists() && ($car === 'x1' || $car === 'accent')",
        "$item": {
          ".validate": "$item.matches(/^[a-z0-9_]{1,40}$/) && newData.hasChild('name')",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "interval_km": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300000"
          },
          "interval_months": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 240"
          }
        }
      }
    },
    "maintenance_logs": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && root.child('members').child(auth.uid).exists()",
        ".validate": "$id.matches(/^[0-9]{14}$/) && newData.hasChildren(['id', 'car', 'itemKey', 'done_km', 'done_date'])",
        "done_km": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
        },
        "done_date": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "memo": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        }
      }
    },
    "frame": {
      "$fid": {
        "index": {
          ".read": "auth != null && ((root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye') || root.child('frame').child($fid).child('viewers').child(auth.uid).exists())",
          ".write": "auth != null && (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye')",
          "$photoId": {
            ".validate": "$photoId.matches(/^[0-9]{16}$/) && newData.hasChildren(['createdAt', 'bytes', 'keyId', 'orient', 'w', 'h', 'by']) && newData.child('bytes').isNumber() && newData.child('bytes').val() > 0 && newData.child('bytes').val() <= 1000000 && (newData.child('orient').val() === 'p' || newData.child('orient').val() === 'l') && newData.child('w').isNumber() && newData.child('h').isNumber() && newData.child('keyId').isString() && newData.child('keyId').val().length <= 10 && (newData.child('by').val() === '진세' || newData.child('by').val() === '지혜')"
          }
        },
        "blobs": {
          "$photoId": {
            ".read": "auth != null && ((root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye') || root.child('frame').child($fid).child('viewers').child(auth.uid).exists())",
            ".write": "auth != null && (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye')",
            ".validate": "$photoId.matches(/^[0-9]{16}$/) && newData.hasChildren(['iv', 'ct', 'keyId']) && newData.child('iv').isString() && newData.child('iv').val().length <= 32 && newData.child('ct').isString() && newData.child('ct').val().length <= 1000000 && newData.child('keyId').isString()"
          }
        },
        "settings": {
          ".read": "auth != null && ((root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye') || root.child('frame').child($fid).child('viewers').child(auth.uid).exists())",
          ".write": "auth != null && (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye')",
          ".validate": "newData.hasChildren(['offlineText', 'showWeather']) && newData.child('offlineText').isString() && newData.child('offlineText').val().length <= 80 && newData.child('showWeather').isBoolean()"
        },
        "devices": {
          ".read": "auth != null && ((root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye') || root.child('frame').child($fid).child('viewers').child(auth.uid).exists())",
          "$deviceId": {
            ".write": "auth != null && (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye')",
            ".validate": "$deviceId.matches(/^dev_[a-z0-9]{8}$/) && newData.hasChildren(['name', 'placement', 'infoBar', 'nightStart', 'nightEnd', 'watch', 'qrCard']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && (newData.child('placement').val() === '미정' || newData.child('placement').val() === '본가' || newData.child('placement').val() === '집') && newData.child('infoBar').isBoolean() && newData.child('watch').isBoolean() && newData.child('qrCard').isBoolean() && newData.child('nightStart').isString() && newData.child('nightStart').val().matches(/^[0-2][0-9]:[0-5][0-9]$/) && newData.child('nightEnd').isString() && newData.child('nightEnd').val().matches(/^[0-2][0-9]:[0-5][0-9]$/)"
          }
        },
        "viewers": {
          ".read": "auth != null && (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye')",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye')",
            ".validate": "newData.hasChildren(['deviceId', 'approvedAt', 'approvedBy']) && newData.child('deviceId').isString() && newData.child('deviceId').val().matches(/^dev_[a-z0-9]{8}$/) && newData.child('approvedAt').isNumber()"
          }
        },
        "pending": {
          ".read": "auth != null && (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye')",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && $fid === 'fam_t2hoijplai' && (auth.uid === $uid || (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye'))",
            ".validate": "newData.hasChildren(['name', 'requestedAt']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 40 && newData.child('requestedAt').isNumber()"
          }
        },
        "heartbeat": {
          ".read": "auth != null && ((root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye') || root.child('frame').child($fid).child('viewers').child(auth.uid).exists())",
          "$deviceId": {
            ".write": "auth != null && root.child('frame').child($fid).child('viewers').child(auth.uid).child('deviceId').val() === $deviceId",
            ".validate": "newData.hasChildren(['lastSeen']) && newData.child('lastSeen').isNumber() && newData.child('lastSeen').val() <= now"
          }
        },
        "alert": {
          ".read": false,
          ".write": false
        }
      }
    },
    "push_subscriptions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye')",
        "$subId": {
          ".validate": "$subId.matches(/^[A-Za-z0-9_-]{8,64}$/) && newData.hasChildren(['endpoint', 'p256dh', 'auth', 'createdAt']) && newData.child('endpoint').isString() && newData.child('endpoint').val().beginsWith('https://') && newData.child('endpoint').val().length <= 1000 && newData.child('p256dh').isString() && newData.child('p256dh').val().length <= 200 && newData.child('auth').isString() && newData.child('auth').val().length <= 100"
        }
      }
    },
    "push_config": {
      ".read": "auth != null && (root.child('members').child(auth.uid).val() === 'jinse' || root.child('members').child(auth.uid).val() === 'jihye')",
      ".write": false
    }
  }
}
